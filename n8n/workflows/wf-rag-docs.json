          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"{{ $json.query }}\",\n  \"top_k\": {{ $json.top_k }}\n}",
        "options": {}
      },
      "id": "33333333-4444-5555-8666-777777777703",
      "name": "Retrieve Chunks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const query = $('Set Query').first().json.query;\nconst payload = $input.first().json;\nconst results = payload.results ?? [];\n\nif (!results.length) {\n  return {\n    query,\n    context: '',\n    sources: [],\n    hasContext: false\n  };\n}\n\nconst contextParts = results.map((r, i) => {\n  const src = r.metadata?.file ?? r.file ?? 'unknown';\n  const page = r.metadata?.page ?? r.page ?? '?';\n  const text = r.text ?? r.content ?? '';\n  return `[${i + 1}] (${src}, trang ${page})\\n${text}`;\n});\n\nconst sources = results.map(r => ({\n  file: r.metadata?.file ?? r.file ?? 'unknown',\n  page: r.metadata?.page ?? r.page ?? null,\n  score: r.score ?? null\n}));\n\nreturn {\n  query,\n  context: JSON.stringify(contextParts.join('\\n\\n---\\n\\n')).slice(1, -1),\n  sources,\n  hasContext: true\n};"
      },
      "id": "44444444-5555-4666-8777-888888888804",
      "name": "Build Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"temperature\": 0.2,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Bạn là trợ lý doanh nghiệp. Chỉ trả lời bằng tiếng Việt dựa trên CONTEXT được cung cấp. Nếu không đủ thông tin, nói rõ 'Không tìm thấy trong tài liệu nội bộ'. Luôn trích dẫn nguồn [file, trang] ở cuối câu trả lời.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"CONTEXT:\\n{{ $json.context || 'Không có context.' }}\\n\\nCÂU HỎI: {{ $json.query }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "55555555-6666-4777-8888-999999999905",
      "name": "Groq Answer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GROQ_API_CREDENTIAL_ID",
          "name": "Groq API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const groq = $input.first().json;\nconst ctx = $('Build Context').first().json;\nconst answer = groq.choices?.[0]?.message?.content ?? 'Không thể tạo câu trả lời.';\n\nreturn {\n  mode: 'RAG',\n  query: ctx.query,\n  answer,\n  sources: ctx.sources,\n  hasContext: ctx.hasContext\n};"
      },
