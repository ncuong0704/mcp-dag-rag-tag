    {
      "parameters": {
        "jsCode": "const query = $('Parse Route').first().json.query;\n\nconst ragResp = await this.helpers.httpRequest({\n  method: 'POST',\n  url: 'http://n8n:5678/webhook/rag',\n  headers: { 'Content-Type': 'application/json' },\n  body: { query },\n  json: true\n});\n\nconst dagResp = await this.helpers.httpRequest({\n  method: 'POST',\n  url: 'http://n8n:5678/webhook/dag',\n  headers: { 'Content-Type': 'application/json' },\n  body: { query },\n  json: true\n});\n\nreturn {\n  mode: 'HYBRID',\n  query,\n  route: 'HYBRID',\n  rag: ragResp,\n  dag: dagResp,\n  answer: `RAG: ${ragResp.answer ?? ragResp.summary ?? JSON.stringify(ragResp)}\\n\\nDAG: ${dagResp.summary ?? dagResp.markdown ?? JSON.stringify(dagResp)}`\n};"
      },
      "id": "mstr0009-0000-4000-8000-000000000009",
      "name": "Hybrid RAG plus DAG",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1380, 720]
    },
    {
      "parameters": {
        "jsCode": "const route = $('Parse Route').first().json;\nconst sub = $input.first().json;\n\nreturn {\n  mode: 'MASTER',\n  route: route.route,\n  query: route.query,\n  classifierRaw: route.classifierRaw,\n  result: sub\n};"
      },
