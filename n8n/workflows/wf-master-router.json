    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"temperature\": 0,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Phân loại câu hỏi tiếng Việt vào MỘT nhãn duy nhất: DAG, RAG, TAG, HYBRID.\\n- DAG: dữ liệu bán hàng, doanh thu, SQL, khách hàng, sản phẩm, đơn hàng\\n- RAG: chính sách, hợp đồng, FAQ, tài liệu nội bộ\\n- TAG: tính toán Python, tìm web, tỷ giá, thống kê\\n- HYBRID: cần cả tài liệu và dữ liệu DB hoặc nhiều nguồn\\nChỉ trả về đúng một từ: DAG, RAG, TAG hoặc HYBRID.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $json.query }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "mstr0003-0000-4000-8000-000000000003",
      "name": "Groq Classify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GROQ_API_CREDENTIAL_ID",
          "name": "Groq API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const query = $('Set Query').first().json.query;\nconst raw = ($input.first().json.choices?.[0]?.message?.content ?? 'TAG').trim().toUpperCase();\nconst allowed = ['DAG', 'RAG', 'TAG', 'HYBRID'];\nconst route = allowed.find(a => raw.includes(a)) ?? 'TAG';\nreturn { query, route, classifierRaw: raw };"
      },
