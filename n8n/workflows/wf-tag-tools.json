            }
          ]
        },
        "options": {}
      },
      "id": "tag00002-0000-4000-8000-000000000002",
      "name": "Set Query",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"temperature\": 0.1,\n  \"tool_choice\": \"auto\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Bạn là trợ lý TAG (Tool-Augmented Generation). Chọn đúng một tool để trả lời câu hỏi tiếng Việt.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $json.query }}\"\n    }\n  ],\n  \"tools\": [\n    {\n      \"type\": \"function\",\n      \"function\": {\n        \"name\": \"python_executor\",\n        \"description\": \"Chạy Python cho tính toán, thống kê, xử lý số liệu.\",\n        \"parameters\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"code\": { \"type\": \"string\", \"description\": \"Mã Python cần chạy\" }\n          },\n          \"required\": [\"code\"]\n        }\n      }\n    },\n    {\n      \"type\": \"function\",\n      \"function\": {\n        \"name\": \"web_search\",\n        \"description\": \"Tìm kiếm thông tin thời sự trên web.\",\n        \"parameters\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"query\": { \"type\": \"string\", \"description\": \"Truy vấn tìm kiếm\" },\n            \"max_results\": { \"type\": \"integer\", \"description\": \"Số kết quả tối đa\", \"default\": 5 }\n          },\n          \"required\": [\"query\"]\n        }\n      }\n    },\n    {\n      \"type\": \"function\",\n      \"function\": {\n        \"name\": \"sql_query\",\n        \"description\": \"Truy vấn dữ liệu bán hàng PostgreSQL qua workflow DAG.\",\n        \"parameters\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"question\": { \"type\": \"string\", \"description\": \"Câu hỏi tiếng Việt về dữ liệu\" }\n          },\n          \"required\": [\"question\"]\n        }\n      }\n    }\n  ]\n}",
        "options": {}
      },
      "id": "tag00003-0000-4000-8000-000000000003",
      "name": "Groq Select Tool",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        400
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GROQ_API_CREDENTIAL_ID",
          "name": "Groq API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const groq = $input.first().json;\nconst query = $('Set Query').first().json.query;\nconst msg = groq.choices?.[0]?.message ?? {};\n\nif (msg.tool_calls?.length) {\n  const tc = msg.tool_calls[0];\n  let args = {};\n  try {\n    args = JSON.parse(tc.function['arguments'] || '{}');\n  } catch (e) {\n    args = {};\n  }\n  return {\n    query,\n    tool: tc.function.name,\n    toolArgs: args,\n    directAnswer: null\n  };\n}\n\nreturn {\n  query,\n  tool: 'none',\n  toolArgs: {},\n  directAnswer: msg.content ?? null\n};"
      },
      "id": "tag00004-0000-4000-8000-000000000004",
      "name": "Parse Tool Call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        400
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.tool }}",
                    "rightValue": "python_executor",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "python_executor"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.tool }}",
                    "rightValue": "web_search",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "web_search"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.tool }}",
                    "rightValue": "sql_query",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "sql_query"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "tag00005-0000-4000-8000-000000000005",
      "name": "Switch Tool",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1120,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/execute-python",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"code\": {{ JSON.stringify($('Parse Tool Call').item.json.toolArgs.code ?? '') }}\n}",
        "options": {}
      },
      "id": "tag00006-0000-4000-8000-000000000006",
      "name": "Execute Python",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
