      "id": "tag00001-0000-4000-8000-000000000001",
      "name": "Webhook TAG",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        400
      ],
      "webhookId": "tag-tools-webhook"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "tq1",
              "name": "query",
              "value": "={{ $json.body?.query ?? $json.query ?? '' }}",
