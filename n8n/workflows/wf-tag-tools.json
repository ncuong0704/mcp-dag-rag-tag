    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/web-search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": {{ JSON.stringify($('Parse Tool Call').item.json.toolArgs.query ?? $('Parse Tool Call').item.json.query) }},\n  \"max_results\": {{ $('Parse Tool Call').item.json.toolArgs.max_results ?? 5 }}\n}",
        "options": {}
      },
      "id": "tag00007-0000-4000-8000-000000000007",
      "name": "Web Search",
      "type": "n8n-nodes-base.httpRequest",
